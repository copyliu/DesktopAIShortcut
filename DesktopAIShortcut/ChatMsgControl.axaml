<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avalonia="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
             xmlns:models="clr-namespace:DesktopAIShortcut.Models"
             xmlns:avalonia1="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:viewModels="clr-namespace:DesktopAIShortcut.ViewModels"
             RenderOptions.TextRenderingMode="Antialias"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DesktopAIShortcut.ChatMsgControl"
             x:DataType="viewModels:ChatMsgViewModel">
    <DockPanel>
        <Label DockPanel.Dock="Top" Content="{Binding UserName}" />

        <StackPanel DockPanel.Dock="Bottom" x:Name="ActionsPanel" Orientation="Horizontal" Spacing="4" Margin="4,0">
            <Button x:Name="CopyMarkdownBtn" Content="复制Markdown" Click="CopyMarkdownBtn_OnClick" />
            <Button x:Name="CopyTextBtn" Content="复制全文" Click="CopyTextBtn_OnClick" />
            <Button x:Name="RegenerateBtn" Content="重新生成" Click="RegenerateBtn_OnClick" />
        </StackPanel>

        <ScrollViewer>
            <StackPanel>
                <Expander x:Name="ReasoningExpander" Header="思考中..." Margin="0,0,0,4" IsVisible="False">
                    <avalonia1:MarkdownRenderer x:Name="ReasoningRenderer"
                                                MarkdownBuilder="{Binding ReasoningBuilder}" />
                </Expander>
                <Border x:Name="Border" CornerRadius="10">
                    <avalonia1:MarkdownRenderer x:Name="MarkdownRenderer"
                                                MarkdownBuilder="{Binding MarkdownStringBuilder}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
