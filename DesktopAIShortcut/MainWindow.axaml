<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:avalonia="clr-namespace:TheArtOfDev.HtmlRenderer.Avalonia;assembly=Avalonia.HtmlRenderer"
        xmlns:desktopAiShortcut="clr-namespace:DesktopAIShortcut"
        xmlns:models="clr-namespace:DesktopAIShortcut.Models"
        xmlns:viewModels="clr-namespace:DesktopAIShortcut.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450" Closing="Window_OnClosing"
        Icon="/Assets/icon.ico"
        ExtendClientAreaToDecorationsHint="True"
        x:Class="DesktopAIShortcut.MainWindow"
        TransparencyLevelHint="Mica, AcrylicBlur"
        MinHeight="300"
        MinWidth="500"
        CanResize="True"
        Title="桌面AI小助手"
        x:DataType="viewModels:ApplicationViewModel"  >
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="30"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="150" MinWidth="80" MaxWidth="400"/>
			<ColumnDefinition Width="Auto"/>
			<ColumnDefinition Width="*" MinWidth="200"/>
		</Grid.ColumnDefinitions>

		<!-- 左侧历史列表 -->
		<Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BorderBrush="Gray" BorderThickness="0,0,1,0">
			<DockPanel>
				<Button DockPanel.Dock="Top" Content="新对话" DataContext="{Binding ChatHistoryListViewModel}" Command="{Binding  AddChatCommand}" HorizontalAlignment="Stretch" Margin="2"/>
				<ScrollViewer>
					<ItemsControl x:Name="HistoryList" ItemsSource="{Binding ChatHistoryListViewModel.ChatHistoryViewModels}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="viewModels:ChatHistoryViewModel">
								<Grid Margin="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="Auto"/>
									</Grid.ColumnDefinitions>
									<Button Grid.Column="0" Grid.ColumnSpan="2"

                                            Command="{Binding  #HistoryList.((viewModels:ApplicationViewModel)DataContext).ChatHistoryListViewModel.SelectChatCommand }"
                                            CommandParameter="{Binding}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Stretch"
                                            VerticalContentAlignment="Center">
										<StackPanel>
											<TextBlock Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis"/>
											<TextBlock Text="{Binding LastUpdateTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                       FontSize="10"
                                                       Opacity="0.6"/>
										</StackPanel>
									</Button>
									<Button Grid.Column="1"
									        VerticalAlignment="Top"
									        Command="{Binding  #HistoryList.((viewModels:ApplicationViewModel)DataContext).ChatHistoryListViewModel.RemoveChatCommand }"
									        CommandParameter="{Binding}"
                                            Content="×"
                                            Margin="2,0,0,0"
                                            Classes="delete"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>

		<!-- 分隔条 -->
		<GridSplitter Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                      Background="Gray"
                      Width="2"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Center"/>

		<!-- 右侧聊天区域 -->
		<Label Grid.Row="0" Grid.Column="2"  Content="桌面AI小助手" IsHitTestVisible="False" VerticalAlignment="Center"/>
		<DockPanel Grid.Row="1" Grid.Column="2" IsHitTestVisible="True"  x:Name="CurrentChatPanel"  DataContext="{Binding ChatHistoryListViewModel.CurrentChatHistoryViewModel  }"
		           IsEnabled="{Binding Converter={x:Static ObjectConverters.IsNotNull}  }"
		           >
			<DockPanel DockPanel.Dock="Bottom"  >
				<Button DockPanel.Dock="Right" Content="△" x:Name="SendBtn" Command="{Binding AddUserMessageAsync}"  VerticalContentAlignment="Stretch"  />
				<TextBox Text="{Binding UserInput}" AcceptsReturn="True" HorizontalAlignment="Stretch" KeyUp="InputElement_OnKeyUp" x:Name="ChatInput"   />
			</DockPanel>
			
			
		 
<Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6" VerticalAlignment="Center" Margin="6">
  <!-- 模型卡片 -->
  <Border Grid.Column="0" Padding="8" Margin="4" CornerRadius="6" Background="#F7F8FA" BorderBrush="#E1E4E8" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="模型" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ComboBox x:Name="ModelList" MinWidth="200" MaxWidth="360" Padding="4" HorizontalAlignment="Stretch" ItemsSource="{Binding Path=$parent[Window].((viewModels:ApplicationViewModel)DataContext).ModelList}" SelectionChanged="ModelList_OnSelectionChanged" >
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="viewModels:ModelSelectionViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding SelectedProvider.Name}" Opacity="0.7" FontSize="12"/>
              <TextBlock Text="·" Opacity="0.4" Margin="2,0"/>
              <TextBlock Text="{Binding SelectedModel}" FontWeight="SemiBold" FontSize="12"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate x:DataType="viewModels:ModelSelectionViewModel">
            <TextBlock Text="{Binding SelectedModel}" FontSize="12"/>
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
      </ComboBox>
    </StackPanel>
  </Border>

  <!-- 提示词预设卡片 -->
  <Border Grid.Column="1" Padding="8" Margin="4" CornerRadius="6" Background="#F7F8FA" BorderBrush="#E1E4E8" BorderThickness="1">
    <StackPanel>
      <TextBlock Text="提示词预设" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ComboBox x:Name="PromptPreset" MinWidth="200" MaxWidth="360" Padding="4" ItemsSource="{Binding Path=$parent[Window].((viewModels:ApplicationViewModel)DataContext).ModelList}">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:PromptTemplate">
            <TextBlock Text="{Binding Name}" FontSize="12"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
  </Border>

  <!-- 问答模式开关 -->
  <Border Grid.Column="2" Padding="8" Margin="4" CornerRadius="6" Background="#F7F8FA" BorderBrush="#E1E4E8" BorderThickness="1" VerticalAlignment="Stretch">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
      <TextBlock Text="问答模式" VerticalAlignment="Center" FontSize="12"/>
      <ToggleSwitch Width="52"  VerticalAlignment="Center" Margin="4,0,0,0"/>
    </StackPanel>
  </Border>
</Grid>

			<ScrollViewer x:Name="ScrollViewer">
				<StackPanel>
					<!-- <desktopAiShortcut:ChatMsgControl DockPanel.Dock="Top" x:Name="defaultMsg" Margin="10"/> -->
					<ItemsControl x:Name="ItemsControl" ItemsSource="{Binding  Path=Messages}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="viewModels:ChatMsgViewModel">
								<desktopAiShortcut:ChatMsgControl Margin="10" DataContext="{Binding .}" x:DataType="viewModels:ChatMsgViewModel"/>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Border Height="30"/>
				</StackPanel>
			</ScrollViewer>
		</DockPanel>
	</Grid>
</Window>