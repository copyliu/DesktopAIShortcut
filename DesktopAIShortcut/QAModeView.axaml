<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonia1="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             xmlns:viewModels="clr-namespace:DesktopAIShortcut.ViewModels"
             x:Class="DesktopAIShortcut.QAModeView"
             x:DataType="viewModels:ChatHistoryViewModel">
    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Padding="8" CornerRadius="6" BorderBrush="#E1E4E8" BorderThickness="1" Margin="0,0,0,8" Background="#F7F8FA">
            <StackPanel Spacing="6">
                <TextBlock Text="输入" FontSize="13" FontWeight="SemiBold" />
                <TextBox Text="{Binding UserInput}" AcceptsReturn="True" MinHeight="80" Watermark="在此输入内容..." />
                <Button Content="发送 →" HorizontalAlignment="Right" Command="{Binding AddUserMessageAsync}" />
            </StackPanel>
        </Border>

        <ScrollViewer>
            <StackPanel Spacing="4">
                <Expander Header="思考中..." IsVisible="{Binding LastAssistant.HasReasoning}"
                          IsExpanded="{Binding LastAssistant.IsThinking}">
                    <avalonia1:MarkdownRenderer MarkdownBuilder="{Binding LastAssistant.ReasoningBuilder}" />
                </Expander>

                <Border Padding="8" CornerRadius="6" BorderBrush="#E1E4E8" BorderThickness="1" Background="#F7F8FA">
                    <StackPanel Spacing="6">
                        <TextBlock Text="输出" FontSize="13" FontWeight="SemiBold" />
                        <avalonia1:MarkdownRenderer MarkdownBuilder="{Binding LastAssistant.MarkdownStringBuilder}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right"
                            IsVisible="{Binding LastAssistant, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Button Content="复制Markdown" Click="CopyMarkdown_OnClick" />
                    <Button Content="复制全文" Click="CopyText_OnClick" />
                    <Button Content="重新生成" Click="Regenerate_OnClick" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
