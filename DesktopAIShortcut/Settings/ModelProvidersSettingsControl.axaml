<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DesktopAIShortcut.ViewModels"
             xmlns:viewModels="clr-namespace:DesktopAIShortcut.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DesktopAIShortcut.Settings.ModelProvidersSettingsControl"
             x:DataType="viewModels:ModelProvidersSettingsViewModel">
    <UserControl.Resources>
      
    </UserControl.Resources>
    <UserControl.DataContext>
        <vm:ModelProvidersSettingsViewModel/>
    </UserControl.DataContext>
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="大模型供应商设置" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,15"/>
        
        <!-- 主要内容区 -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*" Margin="10">
            <!-- 左侧提供商列表 -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                <ListBox ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            
            <!-- 右侧详细设置 -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="10,0,0,0" CornerRadius="5">
                <ScrollViewer >
                    <StackPanel Spacing="10" Margin="10">
                        <TextBlock Text="{Binding SelectedProvider.Name}" FontSize="16" FontWeight="Bold"/>
                        
                        <!-- 启用状态 -->
                        <CheckBox Content="启用该提供商" IsChecked="{Binding SelectedProvider.IsEnabled}"/>
                        
                        <!-- API密钥 -->
                        <TextBlock Text="API密钥" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" PasswordChar="•" Text="{Binding SelectedProvider.ApiKey}" Watermark="请输入API密钥"/>
                            <Button Grid.Column="1" Content="测试连接" Margin="5,0,0,0" Command="{Binding TestConnectionCommand}" 
                                    IsEnabled="{Binding !IsTesting}"/>
                        </Grid>
                        
                        <!-- 端点URL -->
                        <TextBlock Text="API端点" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding SelectedProvider.ApiEndpoint}" Watermark="API端点URL"/>
                        
                        <TextBlock Text="API格式" Margin="0,10,0,0"/>
                        <ComboBox ItemsSource="{Binding  ProviderTypes}" 
                                  SelectedItem="{Binding SelectedProvider.EndpointType}" 
                                    IsEnabled="{Binding !SelectedProvider.FromTemplate}"
                                  >
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource enumConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <!-- 模型选择（多选） -->
                        <TextBlock Text="可用模型" Margin="0,10,0,0"/>
                        <TextBlock Text="(勾选需要使用的模型)" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                        <ItemsControl ItemsSource="{Binding SelectedProvider.AvailableModels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}"
                                             
                                              Command="{Binding ((viewModels:ModelProvidersSettingsViewModel)DataContext).ToggleModelSelectionCommand, 
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                              CommandParameter="{Binding}" >
                                        <CheckBox.IsChecked>
                                            <MultiBinding Converter="{StaticResource ModelSelectionMultiConverter}">
                                                <Binding Path="((viewModels:ModelProvidersSettingsViewModel)DataContext).SelectedProvider.SelectedModels" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                <Binding />
                                            </MultiBinding>
                                        </CheckBox.IsChecked>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        
                        <!-- 添加自定义模型 -->
                        <TextBlock Text="添加自定义模型" Margin="0,15,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding SelectedProvider.CustomModelInput}" Watermark="输入自定义模型名称"/>
                            <Button Grid.Column="1" Content="添加" Margin="5,0,0,0" Command="{Binding AddCustomModelCommand}"/>
                        </Grid>
                        
                        <!-- 已选模型列表 -->
                        <TextBlock Text="已选模型" Margin="0,15,0,0"/>
                        <ListBox ItemsSource="{Binding SelectedProvider.SelectedModels}" MinHeight="60" MaxHeight="100" ScrollViewer.AllowAutoHide="False">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding}" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="移除" 
                                                Command="{Binding ((viewModels:ModelProvidersSettingsViewModel)DataContext).RemoveSelectedModelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10" Spacing="10">
            <Button Content="添加自定义提供商" Command="{Binding AddCustomModelCommand}"/>
            <Button Content="保存设置" Command="{Binding SaveSettingsCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
