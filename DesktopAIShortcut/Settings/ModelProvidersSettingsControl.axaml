<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DesktopAIShortcut.ViewModels"
             xmlns:viewModels="clr-namespace:DesktopAIShortcut.ViewModels"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="450"
             x:Class="DesktopAIShortcut.Settings.ModelProvidersSettingsControl"
             x:DataType="viewModels:ModelProvidersSettingsViewModel">
    
    <UserControl.DataContext>
        <vm:ModelProvidersSettingsViewModel/>
    </UserControl.DataContext>
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="大模型供应商设置" FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,15"/>
        
        <!-- 主要内容区 -->
        <Grid Grid.Row="1" ColumnDefinitions="200,*" Margin="10">
            <!-- 左侧提供商列表 -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" CornerRadius="5">
                <ListBox ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedProvider}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*">
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Margin="0,0,5,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            
            <!-- 右侧详细设置 -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="10,0,0,0" Padding="10" CornerRadius="5">
                <ScrollViewer>
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding SelectedProvider.Name}" FontSize="16" FontWeight="Bold"/>
                        
                        <!-- 启用状态 -->
                        <CheckBox Content="启用该提供商" IsChecked="{Binding SelectedProvider.IsEnabled}"/>
                        
                        <!-- API密钥 -->
                        <TextBlock Text="API密钥" Margin="0,10,0,0"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" PasswordChar="•" Text="{Binding SelectedProvider.ApiKey}" Watermark="请输入API密钥"/>
                            <Button Grid.Column="1" Content="测试连接" Margin="5,0,0,0" Command="{Binding TestConnection}" 
                                    IsEnabled="{Binding !IsTesting}"/>
                        </Grid>
                        
                        <!-- 端点URL -->
                        <TextBlock Text="API端点" Margin="0,10,0,0"/>
                        <TextBox Text="{Binding SelectedProvider.ApiEndpoint}" Watermark="API端点URL"/>
                        
                        <!-- 模型选择 -->
                        <TextBlock Text="模型" Margin="0,10,0,0"/>
                        <ComboBox ItemsSource="{Binding SelectedProvider.AvailableModels}" 
                                  SelectedItem="{Binding SelectedProvider.SelectedModel}"
                                  HorizontalAlignment="Stretch"/>
                        
                        <!-- 其他参数 -->
                        <Expander Header="高级选项" Margin="0,10,0,0">
                            <StackPanel Spacing="10" Margin="0,10,0,0">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="温度:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="1" TickFrequency="0.1" Value="0.7"/>
                                </Grid>
                                
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="最大令牌数:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Slider Grid.Column="1" Minimum="100" Maximum="4000" TickFrequency="100" Value="2000"/>
                                </Grid>
                                
                                <CheckBox Content="流式输出" IsChecked="True"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- 底部按钮区 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,10,10" Spacing="10">
            <Button Content="添加自定义提供商" />
            <Button Content="保存设置" Command="{Binding SaveSettings}"/>
        </StackPanel>
    </Grid>
</UserControl>
